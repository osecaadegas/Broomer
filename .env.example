# Supabase Dashboard > Connect > Framework > Next.js
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Supabase Dashboard > Project Settings > API Keys > Secret keys
# Server-only: never prefix this variable with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY="sb_secret_..."

# GIPHY Developer Dashboard > API Keys
# Public by design: GIPHY requires search and trending requests client-side.
NEXT_PUBLIC_GIPHY_API_KEY="your_giphy_api_key"